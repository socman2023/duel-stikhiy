{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "Bundler", "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx", "strict": true, "noEmit": true, "skipLibCheck": true,
    "resolveJsonModule": true, "allowImportingTsExtensions": true,
    "noUncheckedIndexedAccess": true, "useDefineForClassFields": true, "isolatedModules": true,
    "types": ["vite/client"]
  },
  "include": ["src", "vite.config.ts"]
}
